 ('orbit_applet_add', 'applet_add', 'Queue an applet .js file from the Mac. The phone user must approve each import/update in Applets → Add → From Mac. Does not rebuild iOS.', {'path':{'type':'string'}}, ['path']),
 ('orbit_applet_remove', 'applet_remove', 'Remove a queued applet on Mac, preserving its phone copy and private state.', {'id':{'type':'string'}}, ['id']),
